# CryptoBot — environment template. Copy to .env and fill in. NEVER commit .env.
# Secrets are loaded from environment only. Placeholders below are NOT real credentials.

# ── Mode ─────────────────────────────────────────────────────────────
# paper (default) | testnet | backtest. 'live' additionally requires the multi-step gate.
CRYPTOBOT_MODE=paper

# ── Binance Spot TESTNET credentials (https://testnet.binance.vision) ─
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ── Binance LIVE credentials — leave empty until Phase 6 approval ────
# Key MUST have withdrawals disabled, least privilege, IP allowlisting enabled.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Live gate factor (one of several) — must be exactly this literal to even be considered:
# CONFIRM_LIVE_TRADING=I_UNDERSTAND_THE_RISKS
CONFIRM_LIVE_TRADING=

# ── Database / cache ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cryptobot:change_me@localhost:5432/cryptobot
REDIS_URL=redis://localhost:6379/0

# ── API / dashboard ──────────────────────────────────────────────────
API_SECRET_KEY=generate_a_long_random_string_here
API_HOST=127.0.0.1
API_PORT=8000

# ── Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ── AI assistant (optional; app works fully without it) ─────────────
ANTHROPIC_API_KEY=
AI_LOW_COST_MODEL=claude-haiku-4-5-20251001
AI_ADVANCED_MODEL=claude-sonnet-5
AI_DAILY_BUDGET_USD=2.0
AI_MONTHLY_BUDGET_USD=30.0

# ── Execution routing: analysis | paper | testnet (no live value exists)
EXECUTION_MODE=paper

# ── Cost control (the one profit lever you fully control) ───────────
# market = certain fills but pays spread+slippage; maker_limit = maker fee
# only, cheaper, but the order may never fill. Exits always use market.
ENTRY_ORDER_STYLE=maker_limit
MAKER_LIMIT_OFFSET_BPS=2.0
MAKER_TTL_BARS=3
# Set to 0.25 if you hold BNB and enable the fee discount on Binance
BNB_FEE_DISCOUNT=0.0
# Deployed ML models (optional; cryptobot ml-train populates this directory)
MODEL_REGISTRY_DIR=./model_registry
# Tighter edge requirements + fewer trades when the account is small
SMALL_ACCOUNT_GUARDRAILS=true

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Market data WebSocket streams (FR-1.1, FR-1.4) ─────────────────
CRYPTOBOT_WS_INCLUDE_TRADES=true
CRYPTOBOT_WS_INCLUDE_DEPTH=true
CRYPTOBOT_TRADER_LOCK_TTL_S=30
